#!/bin/sh
# Run the DICOM metadata to XNAT session XML metadata translator
#
# dicom-xnat-mx: dicom-xnat-mx
# XNAT http://www.xnat.org
# Copyright (c) 2017, Washington University School of Medicine
# All Rights Reserved
